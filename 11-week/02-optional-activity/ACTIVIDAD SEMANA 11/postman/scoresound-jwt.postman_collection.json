{
  "info": {
    "name": "ScoreSound API · JWT (semana 11)",
    "description": "Prueba del flujo con JWT. Arranque la API y ejecute la coleccion completa con Run collection: 1) sin token responde 401, 2) el login devuelve el token, 3) con el token responde 200.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · Sin token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 401 Unauthorized\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 · Login (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin\",\n  \"clave\": \"admin123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
              "const cuerpo = pm.response.json();",
              "pm.test(\"Devuelve el token\", () => pm.expect(cuerpo.token).to.be.a(\"string\").and.not.empty);",
              "pm.collectionVariables.set(\"token\", cuerpo.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 · Con token (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    }
  ]
}
